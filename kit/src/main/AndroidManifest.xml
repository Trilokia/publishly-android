<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The JSON update check and the what's-new sources (and kit-promo's feed) need the network; the Play libraries don't -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No package visibility here: the kit sees no other apps. Only kit-promo ("More apps") asks to -->

    <application>
        <!-- The plain-View screen, for apps without Compose. It takes the app's theme -->
        <activity
            android:name=".whatsnew.WhatsNewActivity"
            android:exported="false"
            android:label="@string/kit_whats_new" />
    </application>
</manifest>
